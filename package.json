{
  "name": "icon-editor-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt --write 'src/**/*' vite.config.ts vitest.config.ts 'tsconfig*.json' package.json .oxlintrc.json .oxfmtrc.json index.html",
    "format:check": "oxfmt --check 'src/**/*' vite.config.ts vitest.config.ts 'tsconfig*.json' package.json .oxlintrc.json .oxfmtrc.json index.html",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "bezier-js": "^6.1.4",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
